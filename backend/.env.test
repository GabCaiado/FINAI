# Test profile, loaded by tests/conftest.py (ENV_FILE). Committed on purpose: it holds no secrets.
# CI overrides DATABASE_URL with the throwaway Postgres service; locally SQLite is enough.
ENVIRONMENT=test
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./test_finai.db
JWT_SECRET=
JWT_EXPIRE_HOURS=24
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=15
LLM_CONCURRENCY=4
DAILY_LLM_ROWS_LIMIT=200
GLOBAL_DAILY_LLM_ROWS_LIMIT=3000
MAX_UPLOAD_BYTES=2097152
MAX_IMPORT_ROWS=5000
IMPORT_STALE_MINUTES=10
