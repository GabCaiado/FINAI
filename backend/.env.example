# Copy to backend/.env (git-ignored) and adjust. EVERY variable below except the three
# optional secrets is required: the app refuses to start and names what is missing.
# Real environment variables override this file (that is how the hosts and CI configure it).

# development | test | production. In production the app also refuses weak configuration
# (short JWT_SECRET, COOKIE_SECURE=false, SQLite, http CORS origin, missing LLM key/model).
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite for quick local runs, Postgres everywhere else (see the root .env.example and
# docker-compose.yml): postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=sqlite:///./finai.db

# Optional. Empty -> a random secret per process (sessions are lost on every restart/reload).
# Generate one for local work:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production: 32+ random characters, set in the host dashboard, never in git.
JWT_SECRET=
JWT_EXPIRE_HOURS=24
COOKIE_SECURE=false
# Exact origin of the frontend (scheme + host + port, no trailing slash). Also used by the
# Origin check that protects against CSRF.
CORS_ORIGIN=http://localhost:5173

# openai | mock  (mock = rules and memory only, no network)
LLM_PROVIDER=mock
# Optional unless LLM_PROVIDER=openai. Read the exact model id from the provider console.
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=15
LLM_CONCURRENCY=4
DAILY_LLM_ROWS_LIMIT=200
GLOBAL_DAILY_LLM_ROWS_LIMIT=3000

MAX_UPLOAD_BYTES=2097152
MAX_IMPORT_ROWS=5000
IMPORT_STALE_MINUTES=10
